def _spin() -> str:
    bingkai = UI_SPIN_ASCII if UI_ASCII else UI_SPIN
    return bingkai[SCAN_INFO["n"] % len(bingkai)]


def _sparkline(data) -> str:
    nilai = [max(0.0, float(v)) for v in data]
    if not nilai:
        return ""
    blok = ".:|#" if UI_ASCII else "\u2581\u2582\u2583\u2584\u2585\u2586\u2587\u2588"
    puncak = max(nilai) or 1.0
    return "".join(blok[min(int(v / puncak * (len(blok) - 1)), len(blok) - 1)] for v in nilai)


def _radar_kat(status: str) -> str:
    s = str(status)
    if "IN_POSITION" in s or "PENDING" in s:
        return "posisi"
    if s.startswith("\U0001f7e2") or "OPEN SIGNAL" in s:
        return "sinyal"
    if s.startswith("\U0001f6a8"):
        return "dekat"
    if s.startswith("\u274c") or "VETO" in s:
        return "veto"
    if "COOLDOWN" in s or "PAIR_CAP" in s or "DEDUP" in s or "OVERFLOW" in s:
        return "cooldown"
    if s.startswith("\U0001f319") or "CLOSED" in s:
        return "tutup"
    if s.startswith("\u26d4") or s.startswith("\u26a0") or "FAIL" in s or "ERR" in s:
        return "gagal"
    return "pantau"


def _g(kat: str):
    ikon_uni, ikon_ascii, gaya = RADAR_GLYPH.get(kat, RADAR_GLYPH["pantau"])
    return (ikon_ascii if UI_ASCII else ikon_uni), gaya


