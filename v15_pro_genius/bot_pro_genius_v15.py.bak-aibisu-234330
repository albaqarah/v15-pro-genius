        board[symbol] = f"⚪ OFFLINE/ERR ({str(exc)[:18]})"
        return

    barrier_up = m["open"] + (ATR_MULTIPLIER * m["atr"])
    barrier_dn = m["open"] - (ATR_MULTIPLIER * m["atr"])
    regime = MARKET_REGIME_GLOBAL["market_regime"]

    side = None
    if m["live"] >= barrier_up and m["k"] > STOCH_OB and (m["k"] < m["d"] or not REQUIRE_STOCH_CROSS) and regime != "BULLISH_TREND":
        side = "SHORT"
    elif m["live"] <= barrier_dn and m["k"] < STOCH_OS and (m["k"] > m["d"] or not REQUIRE_STOCH_CROSS) and regime != "BEARISH_TREND":
        side = "LONG"

    if side is None:
        if symbol in REGISTRY.open:
            tag = "IN POSITION"
            _stat("in_position")
        else:
            _lb = abs(m["live"] - m["open"]) >= (ATR_MULTIPLIER * m["atr"])
            _ls = (m["k"] > STOCH_OB) or (m["k"] < STOCH_OS)
            if _lb and _ls:
                _ar = "SHORT" if m["live"] > m["open"] else "LONG"
                _cocok = ((_ar == "SHORT" and m["k"] > STOCH_OB)
                          or (_ar == "LONG" and m["k"] < STOCH_OS))
                tag = "CROSS BLOCK" if _cocok else "ARAH CLASH"
                _stat("cross_block" if _cocok else "arah_clash")
            elif _lb:
                tag = "STOCH"
                _stat("stoch_saja")
            elif _ls:
                tag = "BARRIER"
                _stat("barrier_saja")
            else:
                tag = "IDLE"
                _stat("barrier+stoch")
        board[symbol] = f"⚪ {tag} [K:{m['k']:.1f}|D:{m['d']:.1f}]"
