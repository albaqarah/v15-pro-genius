# --- Panel: radar (mode smart / full) ----------------------------------
def _panel_radar(board: dict):
    pairs = ASSET_PAIRS if DASHBOARD_ROWS <= 0 else ASSET_PAIRS[:DASHBOARD_ROWS]
    hitung = {k: 0 for k in RADAR_GLYPH}
    kats = {}
    for sym in pairs:
        kat = _radar_kat(board.get(sym, "INIT"))
        kats[sym] = kat
        hitung[kat] += 1
    menarik = [s for s in pairs if kats[s] in ("posisi", "sinyal", "dekat", "gagal", "veto")]
    tier = ui_tier()
    smart = RADAR_MODE != "full"

    ringkasan = Text()
    for kat in RADAR_URUT:
        if hitung[kat]:
            ikon, gaya = _g(kat)
            ringkasan.append(f"{ikon} {hitung[kat]:>2} {kat}   ", style=gaya)

    if smart:
        tampil = menarik[:14]
        if not tampil:
            isi = Group(
                Align.center(Text("semua pair tenang \u00b7 menunggu pemicu", style="dim italic")),
                Align.center(ringkasan),
            )
            return Panel(isi, title=f"\u26a1 RADAR \u00b7 {len(pairs)} pair \u00b7 smart",
                         box=_kotak(), border_style="bright_black", padding=(0, 1))
    else:
        tampil = pairs

    lebar_sel = 30 if tier in ("wide", "mid") else 26
    kolom = DASHBOARD_COLS if DASHBOARD_COLS > 0 else max(1, ui_width() // lebar_sel)
    baris = math.ceil(len(tampil) / kolom) or 1
    grid = Table.grid(expand=True, padding=(0, 2))
    for _ in range(kolom):
        grid.add_column(ratio=1)
    for r in range(baris):
        sel = []
        for c in range(kolom):
            idx = r + c * baris
            if idx < len(tampil):
                sym = tampil[idx]
                status = str(board.get(sym, "INIT"))
                kat = kats[sym]
                ikon, gaya = _g(kat)
                nama = sym.replace("/USDT:USDT", "").replace("/USDT", "")
                sel.append(Text.assemble(
                    (f"{ikon} ", gaya),
                    (f"{nama:<5}", "bold bright_white" if is_tradfi(sym) else "white"),
                    (status[:lebar_sel - 9], gaya if kat != "pantau" else "dim"),
                ))
            else:
                sel.append("")
        grid.add_row(*sel)
    isi = Group(grid, Align.center(ringkasan))
    label = "smart" if smart else "full"
    return Panel(isi, title=f"\u26a1 RADAR \u00b7 {len(pairs)} pair \u00b7 {label}",
                 box=_kotak(), border_style="bright_black", padding=(0, 1))


