async def tg_send(text: str, retries: int = 3) -> bool:
    if not TELEGRAM_TOKEN or not TELEGRAM_CHAT_ID:
        log.warning("Telegram tidak dikonfigurasi, pesan dilewati.")
        return False
    url = f"{TELEGRAM_API}/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": TELEGRAM_CHAT_ID, "text": text, "parse_mode": "Markdown",
               "disable_web_page_preview": True}
    for attempt in range(1, retries + 1):
        try:
            async with httpx.AsyncClient() as client:
                res = await client.post(url, json=payload, timeout=10.0)
            if res.status_code == 200:
                return True
            log.error("Telegram HTTP %s: %s", res.status_code, res.text[:200])
            if res.status_code == 400:  # markdown rusak -> kirim plain
                payload.pop("parse_mode", None)
        except Exception as exc:
            log.error("Telegram error (attempt %s): %s", attempt, exc)
        await asyncio.sleep(1.5 * attempt)
    return False


